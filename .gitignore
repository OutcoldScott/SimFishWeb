# Multi-angle capture-pass renders written by capture_pass.gd.
shaders-godot/godot-project/capture_pass_*.png
shaders-godot/godot-project/capture_pass_*.png.import

# Web fallback fonts - downloaded + subsetted by the container font-builder
# stage at build time, never committed. The .import sidecars Godot generates
# for them are transient too.
shaders-godot/godot-project/fonts/

